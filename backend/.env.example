# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string
# Local:  postgresql://postgres:password@localhost:5432/cybershield
# Cloud (Neon/Supabase): use the connection string they give you
DATABASE_URL=postgresql://postgres:password@localhost:5432/cybershield

# JWT
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini API (get free key at https://aistudio.google.com/apikey)
# Keys created after mid-2026 are "auth keys" and start with AQ. (not the older AIza... format) — both work the same way here.
GEMINI_API_KEY=

# Neo4j (added Day 5)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# ---- Staff (police / admin) access control ----------------------------
# Code an officer must supply to self-register a police account.
# Leave EMPTY to disable officer self-registration entirely (recommended in
# production: create staff accounts with app/scripts/manage_staff.py instead).
OFFICER_REGISTRATION_CODE=

# Require a TOTP authenticator app for police/admin sign-in.
REQUIRE_MFA_FOR_STAFF=true
MFA_ISSUER=CyberAid

# Session lifetimes (minutes)
STAFF_TOKEN_EXPIRE_MINUTES=30
MFA_ENROLLMENT_TOKEN_MINUTES=10

# Failed-attempt lockout
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Password minimums
MIN_PASSWORD_LENGTH=8
MIN_STAFF_PASSWORD_LENGTH=12
